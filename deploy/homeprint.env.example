# Copy to ~/.config/homeprint/homeprint.env

# Cloudflare Access (Zero Trust). Both are required; requests without a valid sign-in are refused.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=paste-the-access-application-aud-tag-here

# Who may run cleanings (comma-separated emails). Empty = everyone who can sign in.
HOMEPRINT_MAINT_USERS=

# Printer setup on this machine
HOMEPRINT_QUEUE=Canon_G3010
HOMEPRINT_MAINT_QUEUE=Canon_G3010_Canon
HOMEPRINT_SCANNER=pixma:04A9183B_92B81B
HOMEPRINT_PRINTER_NAME=Canon G3010

# Optional: friendly names, a JSON file like {"mom@example.com": "Mom"}
# HOMEPRINT_NAMES=/home/taktekbot/.config/homeprint/names.json
