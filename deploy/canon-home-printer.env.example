# Copy to /etc/canon-home-printer.env (chmod 640) and fill in.

# Cloudflare Access (Zero Trust). Both are required; without them every request is refused.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=paste-the-access-application-aud-tag-here

# Who may run cleanings and cancel other people's prints (comma-separated). Empty = everyone signed in.
CHP_MAINT_USERS=

# Words used in messages to the family.
CHP_ADMIN_NAME=Alex
CHP_COMPUTER_NAME=the laptop

# The printer on this machine.
CHP_PRINTER_NAME=Canon G3010
CHP_QUEUE=Canon_G3010
# A second queue for maintenance bytes is optional; raw jobs work through the print queue.
# CHP_MAINT_QUEUE=Canon_G3010
# SANE device from `scanimage -L`; empty = the first scanner found.
CHP_SCANNER=
# USB ids from `lsusb` (Canon is 04a9; the G3010 is 183b).
CHP_USB_VENDOR=04a9
CHP_USB_PRODUCT=183b

# Where to listen. Keep it on 127.0.0.1: the Cloudflare Tunnel is the way in.
CHP_ADDR=127.0.0.1:8091

# Optional: friendly names, a JSON file like {"mom@example.com": "Mom"}
# CHP_NAMES=/etc/canon-home-printer.names.json

# LibreOffice command for Word, Excel and PowerPoint files; empty = soffice from PATH.
# CHP_SOFFICE=/usr/bin/soffice
